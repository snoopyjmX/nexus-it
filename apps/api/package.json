  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  },
  "files": [
    "dist"
  ]
