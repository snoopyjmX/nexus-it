{
  "name": "nexus-it",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "db:migrate": "pnpm --filter @nexus/api db:migrate",
    "dev:api": "pnpm --filter @nexus/api dev",
    "dev:web": "pnpm --filter @nexus/web dev",
    "db:seed": "pnpm --filter @nexus/api db:seed",
    "user:create": "pnpm --filter @nexus/api user:create",
    "embeddings:backfill": "pnpm --filter @nexus/api embeddings:backfill",
    "auth:bench": "pnpm --filter @nexus/api auth:bench"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
