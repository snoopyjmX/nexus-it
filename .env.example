# Copie para .env (e .env.test) e preencha localmente. Nunca faça commit desses arquivos.
# Senha só do Postgres local do Docker Compose.
POSTGRES_PASSWORD=
# .env.test deve conter apenas:
# DATABASE_URL=postgres://nexus:<POSTGRES_PASSWORD>@127.0.0.1:5432/nexus_test
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_ENABLED=false
# Busca vetorial (ADR-007). Desligada por padrão: sem ela a busca é lexical. Precisa do modelo no Ollama.
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=bge-m3
EMBEDDING_TIMEOUT_MS=15000
# Limiar de similaridade de cosseno; recalibrar na base real (Fase 3).
VECTOR_MIN_SCORE=0.5393
# Senha dos usuários do `pnpm db:seed` (mínimo de 12 caracteres). Sem valor padrão de propósito.
SEED_PASSWORD=
